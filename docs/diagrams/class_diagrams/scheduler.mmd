---
config:
  theme: redux
---
classDiagram
direction TB
    %% Scheduler Classes
    class SchedulerBase {
        <<abstract>>
        #Logger logger
        #boolean running
        #Cache cache
        #function onMessage
        +constructor(cache, onMessage)
        +start()* void
        +stop()* void
    }

    class ContinuousScheduler {
        -NodeJS.Timeout intervalId
        +start() void
        +stop() void
        -processMessages() void
    }

    class IntervalScheduler {
        -NodeJS.Timeout intervalId
        -number intervalMs
        +constructor(cache, onMessage, intervalMs)
        +start() void
        +stop() void
        -processBatch() void
    }

    class SchedulerFactory {
        <<static>>
        +create(mode: SchedulerMode, cache: Cache, onMessage, intervalMs?) SchedulerBase
    }

    SchedulerBase <|-- ContinuousScheduler : extends
    SchedulerBase <|-- IntervalScheduler : extends
    SchedulerFactory ..> SchedulerBase : creates
    SchedulerBase ..> Cache : uses
    SchedulerBase ..> Message : uses
